{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headed": "cypress run --headed",
    "test:e2e": "start-server-and-test dev http://localhost:1420 cypress:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:1420 cypress:open",
    "test:e2e:real": "cypress run --spec 'cypress/e2e/real-e2e/**/*.cy.ts'",
    "test:e2e:real:open": "cypress open --spec 'cypress/e2e/real-e2e/**/*.cy.ts'",
    "test:e2e:auth": "cypress run --spec 'cypress/e2e/auth.cy.ts'",
    "test:e2e:security": "cypress run --spec 'cypress/e2e/security.cy.ts'"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query": "^5.90.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.22",
    "cypress": "^15.7.1",
    "postcss": "^8.5.6",
    "start-server-and-test": "^2.0.8",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
